<!DOCTYPE html>
<html>
<head><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#060b11; color:#fff;}</style></head>
<body>
    <%- include('navbar') %>
    <div class="container mt-4" style="max-width: 600px;">
        <h3>Chat dengan: <%= chatUser %></h3>
        <div class="bg-dark p-3 rounded" style="height: 400px; overflow-y: auto;">
            <% messages.forEach(msg => { %>
                <div class="mb-2 <%= msg.sender === 'admin' ? 'text-end' : 'text-start' %>">
                    <small class="text-secondary"><%= msg.sender.toUpperCase() %></small>
                    <div class="p-2 rounded <%= msg.sender === 'admin' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                        <%= msg.pesan %>
                    </div>
                </div>
            <% }) %>
        </div>
        <form action="/admin/chats/<%= chatUser %>/reply" method="POST" class="mt-3 d-flex">
            <input type="text" name="pesan" class="form-control" placeholder="Balas pesan..." required>
            <button class="btn btn-warning">Balas</button>
        </form>
    </div>
</body>
</html>
