<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>body{background:#060b11; color:#fff;}</style>
</head>
<body>
    <%- include('navbar') %>
    <div class="container mt-4" style="max-width: 600px;">
        <h4 class="text-info mb-3">💬 Live Support</h4>
        <div class="bg-dark p-3 rounded" style="height: 400px; overflow-y: auto;">
            <% messages.forEach(msg => { %>
                <div class="mb-2 <%= msg.sender === 'user' ? 'text-end' : 'text-start' %>">
                    <small class="text-secondary"><%= msg.sender.toUpperCase() %> - <%= msg.tanggal %></small>
                    <div class="p-2 rounded <%= msg.sender === 'user' ? 'bg-primary' : 'bg-secondary' %>">
                        <%= msg.pesan %>
                    </div>
                </div>
            <% }) %>
        </div>
        <form action="/chat/send" method="POST" class="mt-3 d-flex">
            <input type="text" name="pesan" class="form-control" placeholder="Tulis pesan..." required>
            <button class="btn btn-primary">Kirim</button>
        </form>
    </div>
</body>
</html>
