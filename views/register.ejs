<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - GTA SAMP Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #060b11; color: #f1f5f9; font-family: 'Poppins', sans-serif; }
        .auth-card { background-color: #0b131e; border: 1px solid rgba(0, 136, 255, 0.3); border-radius: 20px; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7); width: 100%; max-width: 400px; }
        .form-control-cyber { background-color: #05090e; border: 1px solid rgba(255, 255, 255, 0.1); color: #fff; border-radius: 12px; padding: 12px 16px; transition: 0.3s; }
        .form-control-cyber:focus { background-color: #05090e; border-color: #0088ff; box-shadow: 0 0 12px rgba(0, 136, 255, 0.4); color: #fff; outline: none; }
        .btn-cyber { background: linear-gradient(135deg, #0072ff 0%, #00c6ff 100%); color: #fff; border: none; border-radius: 12px; font-weight: 700; padding: 12px; box-shadow: 0 4px 15px rgba(0, 136, 255, 0.4); transition: 0.3s; }
        .btn-cyber:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0, 136, 255, 0.6); color: #fff; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="auth-card p-4 p-sm-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold" style="background: linear-gradient(135deg, #0088ff 0%, #00d4ff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">🎮 Buat Akun Baru</h3>
            <p class="text-secondary small">Daftar akun untuk bergabung di GTA SAMP Hub</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger py-2 small rounded-3" style="background: rgba(255, 82, 82, 0.15); border: 1px solid rgba(255, 82, 82, 0.3); color: #ff5252;"><%= error %></div>
        <% } %>

        <form action="/register" method="POST">
            <div class="mb-3">
                <label class="form-label text-secondary small">Username</label>
                <input type="text" name="username" class="form-control form-control-cyber" required placeholder="Buat username">
            </div>
            <div class="mb-4">
                <label class="form-label text-secondary small">Password</label>
                <input type="password" name="password" class="form-control form-control-cyber" required placeholder="Buat password">
            </div>
            <button type="submit" class="btn btn-cyber w-100 mb-3">Daftar Akun</button>
        </form>

        <p class="text-center mb-0 small text-secondary">
            Sudah punya akun? <a href="/login" class="text-info text-decoration-none fw-semibold">Login disini</a>
        </p>
    </div>
</body>
</html>
