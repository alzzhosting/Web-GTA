<!DOCTYPE html>
<html>
<head><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#060b11; color:#fff;}</style></head>
<body>
    <%- include('navbar') %>
    <div class="container mt-4">
        <h3>👑 Chat Support Admin</h3>
        <ul class="list-group mt-3">
            <% users.forEach(user => { %>
                <li class="list-group-item bg-dark text-white d-flex justify-content-between">
                    <%= user %>
                    <a href="/admin/chats/<%= user %>" class="btn btn-sm btn-info">Buka Chat</a>
                </li>
            <% }) %>
        </ul>
    </div>
</body>
</html>
